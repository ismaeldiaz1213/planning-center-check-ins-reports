# Dockerfile.api
#
# Cloud Run Service image — FastAPI server + built React SPA.
# Built via:  cloudbuild-api.yaml   (gcloud builds submit --config cloudbuild-api.yaml)
# Run as:     uvicorn api:app --host 0.0.0.0 --port 8080
#
# Prerequisites before submitting a build:
#   1. cd frontend && npm run build   ← writes backend/static/
#   2. credentials.json must exist at the project root

FROM python:3.11-slim

WORKDIR /app

COPY backend/requirements.txt      requirements.txt
COPY backend/requirements-web.txt  requirements-web.txt

RUN pip install --no-cache-dir -r requirements.txt -r requirements-web.txt

COPY backend/ .

# credentials.json is NOT baked into the image.
# Supply it at runtime:
#   Cloud Run: mount to a path outside /app — a secret volume replaces the entire last
#     directory of its mount path, which would hide the files COPYed above if mounted
#     straight into /app. GOOGLE_APPLICATION_CREDENTIALS tells the app where to find it:
#       --set-secrets=/secrets/credentials.json=google-service-account-key:latest
#       --set-env-vars=GOOGLE_APPLICATION_CREDENTIALS=/secrets/credentials.json
#   Local dev: -v $(pwd)/credentials.json:/app/credentials.json
#     (safe locally — a single-file bind-mount doesn't replace the whole directory)

EXPOSE 8080

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8080"]
