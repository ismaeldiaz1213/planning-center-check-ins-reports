# Planning Center OAuth credentials
# Get these from https://api.planningcenteronline.com/oauth/applications
PCO_APP_ID=replace_me
PCO_SECRET=replace_me

# Google Drive folder where generated rosters will be uploaded
# Right-click the target folder in Google Drive → "Get link" → copy the ID from the URL
GOOGLE_DRIVE_PARENT_FOLDER_ID=replace_me

# Path to your Google service account key file (see docs/SETUP.md for how to create one)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Google OAuth client ID for the web login
# Get this from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=replace_me

# Comma-separated list of allowed Google domains for login (e.g. your church's G Suite domain)
# Leave blank to allow any authenticated Google account
ALLOWED_GOOGLE_DOMAINS=examplechurch.org
